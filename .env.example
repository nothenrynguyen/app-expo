NEXT_PUBLIC_LOGO_DEV_TOKEN=

# Enable only for the production deployment on a Vercel Hobby account.
# First enable Web Analytics in the project's Vercel dashboard. No paid trial.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Optional owned activity collector. HTTPS URL ending in /collect, production only.
# Leave empty until the Worker, private report key and D1 database are verified.
# This is a public endpoint, never an owner key or a Cloudflare API token.
# A configured endpoint replaces Vercel collection and requires fresh v2 consent.
NEXT_PUBLIC_ACTIVITY_ENDPOINT=

# Research only. Obtain your own USAJOBS key and keep credentials out of public data.
USAJOBS_API_KEY=
USAJOBS_EMAIL=
# Set true only after the access/zero-cost review in docs/USAJOBS_PILOT.md.
USAJOBS_PILOT_COST_REVIEWED=false

# Set false to turn off automatic USAJOBS discovery locally.
# Source configuration is in data/usajobs-config.json; credentials are server-side only.
USAJOBS_ENABLE_DISCOVERY=false
